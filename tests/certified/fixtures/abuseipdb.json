{
  "integration": "AbuseIPDB",
  "routes": [
    {
      "name": "revoked key",
      "source": "hand-written from the AbuseIPDB v2 API docs error format",
      "method": "GET",
      "host": "api.abuseipdb.com",
      "path": "/api/v2/check",
      "headers": {
        "Key": "dbot-replay-revoked-key"
      },
      "response": {
        "status": 401,
        "body": {
          "errors": [
            {
              "detail": "Authentication failed. Your API key is either missing, incorrect, or revoked. Note: The APIv2 key differs from the APIv1 key.",
              "status": 401
            }
          ]
        }
      }
    },
    {
